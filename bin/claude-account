#!/usr/bin/env python3
"""
claude-account — list the Claude account aliases on this Mac, or scaffold a new one.

    claude-account list [--json]
    claude-account add <alias>

An "account" is a config dir: ~/.claude (default) or ~/.claude-<alias> with a
.claude.json inside (only present after the first login). `add` creates the dir
and the shell alias, then tells you how to log in — login itself is interactive
and cannot be automated.

The other tools (claude-status, claude-renew, limit-reset) discover accounts
the same way, so a new account joins them automatically after its first login.
"""

import argparse, glob, hashlib, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
ZSHRC = os.path.join(HOME, ".zshrc")
# dirs that look like accounts but aren't OAuth accounts
NOT_ACCOUNTS = {".claude-deepinfra", ".claude-session-backups"}


def keychain_has(service):
    return subprocess.run(["security", "find-generic-password", "-s", service],
                          capture_output=True).returncode == 0


def zshrc_aliases():
    try:
        txt = open(ZSHRC).read()
    except OSError:
        return {}
    return dict(re.findall(r"^alias (claude-[\w-]+)='([^']+)'", txt, re.M))


def live_count(cfg_dir):
    n = 0
    for f in glob.glob(os.path.join(cfg_dir, "sessions", "*.json")):
        try:
            j = json.load(open(f))
            os.kill(j["pid"], 0)
            n += 1
        except Exception:
            pass
    return n


def account_rows():
    rows = []
    # default account: config JSON lives at ~/.claude.json (NOT ~/.claude/.claude.json)
    rows.append(row("default", os.path.join(HOME, ".claude"),
                    os.path.join(HOME, ".claude.json"),
                    "Claude Code-credentials", alias="claude"))
    aliases = zshrc_aliases()
    for d in sorted(glob.glob(os.path.join(HOME, ".claude-*"))):
        base = os.path.basename(d)
        if base in NOT_ACCOUNTS or not os.path.isdir(d):
            continue
        name = base[len(".claude-"):]
        svc = "Claude Code-credentials-" + hashlib.sha256(d.encode()).hexdigest()[:8]
        alias = f"claude-{name}" if f"claude-{name}" in aliases else None
        rows.append(row(name, d, os.path.join(d, ".claude.json"), svc, alias=alias))
    return rows


def row(name, cfg_dir, cfg_json, service, alias):
    email = None
    if os.path.isfile(cfg_json):
        try:
            email = (json.load(open(cfg_json)).get("oauthAccount") or {}
                     ).get("emailAddress")
        except Exception:
            pass
    return {"alias": name, "dir": cfg_dir, "shell_alias": alias,
            "email": email, "logged_in": bool(email),
            "keychain": keychain_has(service), "live_sessions": live_count(cfg_dir)}


def cmd_list(a):
    rows = account_rows()
    if a.json:
        print(json.dumps(rows, indent=1))
        return
    for r in rows:
        state = (f"✓ {r['email']}" if r["logged_in"]
                 else "✗ not logged in — run the alias once and /login")
        kc = "" if r["keychain"] else "  (no keychain credential)"
        live = f"  {r['live_sessions']} live" if r["live_sessions"] else ""
        sa = r["shell_alias"] or "NO SHELL ALIAS"
        print(f"{r['alias']:<10} {sa:<14} {state}{kc}{live}")


def cmd_add(a):
    name = a.alias.lower()
    if not re.fullmatch(r"[a-z0-9][\w-]*", name):
        sys.exit(f"bad alias {a.alias!r} — letters/digits/dashes only")
    if name == "default" or name in (r["alias"] for r in account_rows()):
        sys.exit(f"account {name!r} already exists")
    d = os.path.join(HOME, f".claude-{name}")
    if os.path.exists(d):
        sys.exit(f"{d} already exists")
    os.makedirs(d)
    shell_alias = f"claude-{name}"
    line = f"alias {shell_alias}='CLAUDE_CONFIG_DIR=$HOME/.claude-{name} claude'"
    if shell_alias in zshrc_aliases():
        print(f"~/.zshrc already has {shell_alias}")
    else:
        with open(ZSHRC, "a") as f:
            f.write(f"\n# Claude account '{name}' (claude-account add, auto)\n{line}\n")
        print(f"created {d} and added {shell_alias} to ~/.zshrc")
    print(f"""
Next steps:
  1. open a NEW terminal (or `source ~/.zshrc`)
  2. run `{shell_alias}` and log in with /login
  3. after login the account is auto-discovered by claude-status,
     claude-renew and the morning limit-reset job — nothing else to do.

Note: do NOT create {d}/.claude.json by hand — the first login writes it.""")


def main():
    ap = argparse.ArgumentParser(prog="claude-account",
                                 description="List or scaffold Claude account aliases.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("list", help="show all accounts and their state")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("add", help="scaffold a new account alias")
    p.add_argument("alias")
    p.set_defaults(fn=cmd_add)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
