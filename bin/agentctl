#!/usr/bin/env python3
"""agentctl — dispatcher. Symlinked into /opt/homebrew/bin; resolves the repo
through the symlink so the package next to it is importable."""
import os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from agentctl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
